# Copy this file to .env and paste your key after the = sign.
# .env is listed in .gitignore, so it never gets uploaded to GitHub.
ANTHROPIC_API_KEY=

# Optional: Sign in with Microsoft and Outlook calendar (see README, "Microsoft sign-in, Outlook and Teams")
MICROSOFT_CLIENT_ID=

# Optional: Sign in with Google and Google Calendar (see README, "Google sign-in and calendar")
GOOGLE_CLIENT_ID=
# Any long random text. Keeps sign-ins secure. Must stay the same once set.
SESSION_SECRET=
